---
import Layout from "../layouts/Layout.astro";

// Narrative-shell increment (docs/PROJECT_BRIEF.md, Act 1 + Act 3) plus the
// postscript coda (docs/EPILOGUE.md). Still no colour system, arc
// transition, veil, or tide effect, and no Norway silhouette/ruler-readout
// choreography — those need the visual system (step 5) that doesn't exist
// yet, so the coda here is the same plain, text-only treatment as the
// resolution above it.
const revealCopy = [
  "Every segment becomes four. Each new segment is one third as long.",
  "Measure it as a line: the total grows by 4/3 at every step.",
  "Measure the boundary as area: the total shrinks toward zero.",
  "Between length and area is one exponent that stays stable.",
  "That exponent is the curve's Hausdorff dimension.",
];
---

<Layout title="How long is Norway's coastline? — a Hausdorff dimension explainer">
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <section id="intro-scene" class="intro-scene" aria-label="Introduction">
      <div class="intro-copy">
        <p class="intro-line" data-line="1">
          Before we begin, consider one question&hellip;
        </p>
        <p class="intro-line" data-line="2">How long is Norway&rsquo;s coastline?</p>
      </div>
      <button id="compass-button" class="compass-button" type="button">
        Continue to the Koch snowflake construction
      </button>
    </section>
    <section
      id="koch-scene"
      class="koch-scene"
      data-iteration="0"
      data-max-reveal-stage="0"
    >
      <div class="koch-sticky">
        <div class="koch-visual">
          <svg
            class="koch-svg"
            viewBox="-1.2 -1.2 2.4 2.4"
            role="img"
            aria-label="Koch snowflake construction, current iteration"
          >
            <g class="koch-wrapper" id="koch-wrapper">
              <path id="koch-path" vector-effect="non-scaling-stroke" />
            </g>
          </svg>
          <p class="scroll-cue">Scroll to look closer.</p>
        </div>
        <div class="koch-copy">
          <h1>Meet the Koch snowflake.</h1>
          <ol class="reveal-list" id="reveal-list">
            {revealCopy.map((text, i) => <li data-stage={i + 1}>{text}</li>)}
          </ol>
          <dl class="instrumentation" id="instrumentation">
            <div>
              <dt>Iteration</dt>
              <dd id="stat-iteration">0</dd>
            </div>
            <div>
              <dt>Segments</dt>
              <dd id="stat-segments">3</dd>
            </div>
            <div>
              <dt>Cover scale</dt>
              <dd id="stat-scale">1.000000</dd>
            </div>
            <div>
              <dt>1D measure</dt>
              <dd id="stat-m1">3.0000</dd>
            </div>
            <div>
              <dt>Critical measure</dt>
              <dd id="stat-md">3.0000</dd>
            </div>
            <div>
              <dt>2D measure of the boundary</dt>
              <dd id="stat-m2">3.000000</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
    <section id="resolution-scene" class="resolution-scene" aria-label="Resolution">
      <p class="resolution-line" data-stage="1">
        Length says infinity. Area says zero. Dimension tells us which measure
        fits.
      </p>
      <pre class="resolution-formula" data-stage="2">M_s(epsilon) = N(epsilon) * epsilon^s</pre>
      <pre class="resolution-formula" data-stage="3">4 copies, each scaled to 1/3
D = log(4) / log(3) &#8776; 1.262</pre>
      <p class="resolution-line" data-stage="4">
        Below D, the scale-weighted measure explodes. Above D, it vanishes. D
        is the critical exponent between a line (1) and a plane (2).
      </p>
      <details class="resolution-detail" data-stage="5">
        <summary>Formal definition</summary>
        <pre>H^s_delta(F) = inf sum_i diam(U_i)^s
dim_H(F) = inf &#123; s : H^s(F) = 0 &#125;</pre>
        <p>
          Cover the set with pieces no larger than delta, choose the cheapest
          such cover, then let delta shrink. The critical exponent is its
          Hausdorff dimension.
        </p>
      </details>
      <p class="resolution-line" data-stage="6">
        Norway is not a perfect mathematical fractal. But the same
        measurement problem returns: a smaller step follows more detail, so a
        coastline length is incomplete without its scale and convention.
      </p>
      <p class="resolution-final" data-stage="7">The ruler is part of the answer.</p>
    </section>
    <section id="postscript-scene" class="postscript-scene" aria-label="Postscript">
      <p class="postscript-label">A postscript</p>
      <p class="postscript-line" data-stage="1">
        We use simple measures
        <br />
        to make a complex world legible.
      </p>
      <p class="postscript-line" data-stage="2">But every ruler leaves something out.</p>
      <p class="postscript-final" data-stage="3">
        The world does not run out of detail
        <br />
        when our ruler does.
      </p>
      <a href="#intro-scene" id="measure-again" class="measure-again">Measure again</a>
    </section>
  </main>
  <script src="../scripts/intro.ts"></script>
  <script src="../scripts/koch-scene.ts"></script>
  <script src="../scripts/resolution.ts"></script>
  <script src="../scripts/postscript.ts"></script>
</Layout>
