---
import Layout from "../layouts/Layout.astro";
import { NORWAY_LAND_PATH, NORWAY_COASTLINE_PATH, NORWAY_VIEWBOX } from "../lib/norway.ts";
import { BRITAIN_COASTLINE_PATH, BRITAIN_VIEWBOX } from "../lib/britain.ts";
import {
  NORWAY_OUTLINE_ROUGH_PATH,
  NORWAY_OUTLINE_DETAILED_PATH,
  NORWAY_OUTLINE_FINE_PATH,
} from "../lib/coastline-samples.ts";
import { generateKochPoints, kochPathD, MAX_ITERATION } from "../lib/koch.ts";
import { generateHilbertPoints, hilbertPathD } from "../lib/hilbert.ts";
import { generateDragonPoints, dragonPathD, getDragonViewBox } from "../lib/dragon.ts";

// Finest Koch iteration, computed once at build time (it never changes at
// runtime) — the static faint reference outline behind the bright,
// currently-measured outline. See CLAUDE.md "Global correction of the ruler
// misunderstanding": faint = finer detail that exists in the reference,
// bright = the detail retained by the current measurement.
const referencePathD = kochPathD(generateKochPoints(MAX_ITERATION));

// Decorative background for the "curves that nearly fill the plane" aside
// (docs/Refine_Explanations.md §6) — a faint, fixed-order Hilbert curve, not
// a Koch iteration, so it visually distinguishes "other fractals exist" from
// the page's one worked example.
const hilbertBgPathD = hilbertPathD(generateHilbertPoints());

// Postscript background motif: a single dragon curve, revealed at increasing
// order in step with the postscript's three text stages — replaces the
// earlier small Norway-coastline echo. Fixed orders, no runtime controls.
const DRAGON_ORDERS = [7, 9, 11];
const dragonPointSets = DRAGON_ORDERS.map((order) => generateDragonPoints(order));
const dragonViewBox = getDragonViewBox(dragonPointSets[dragonPointSets.length - 1]);
const dragonStages = dragonPointSets.map((points, i) => ({
  stage: i + 1,
  d: dragonPathD(points),
}));

// Visual-refinement increment (docs/PROJECT_BRIEF.md, step 5): colour system,
// Norway silhouette, arc divider, and the postscript's coastline echo /
// disappearing readout (docs/EPILOGUE.md). Tide effect is an explicit
// stretch goal in the brief and is not implemented here.
const revealCopy = [
  "Smaller details are ignored.",
  "Keep more detail.",
  "The measured boundary gets longer.",
  "For this curve, new detail never ends.",
  "So its ordinary length never settles.",
];
---

<Layout title="How long is Norway's coastline? — a Hausdorff dimension explainer">
  <main>
    <section id="intro-scene" class="intro-scene" aria-label="Introduction">
      <nav class="home-nav" aria-label="Primary">
        <a href="./">Home</a>
      </nav>
      <svg
        class="intro-silhouette"
        viewBox={NORWAY_VIEWBOX}
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <path class="norway-land" d={NORWAY_LAND_PATH} />
        <path class="norway-coastline" d={NORWAY_COASTLINE_PATH} />
      </svg>
      <div class="intro-voile" aria-hidden="true"></div>
      <div class="intro-copy">
        <p class="intro-line" data-line="1">
          Before we begin, consider one question&hellip;
        </p>
        <p class="intro-line" data-line="2">How long is Norway&rsquo;s coastline?</p>
      </div>
      <button id="compass-button" class="compass-button" type="button">
        Begin the journey
      </button>
      <svg
        class="intro-arc"
        viewBox="0 0 100 10"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M 0 10 L 0 6 Q 50 -4 100 6 L 100 10 Z" />
      </svg>
    </section>
    <section id="idea-scene" class="idea-scene" aria-label="The idea">
      <div class="idea-copy">
        <p class="idea-title" data-idea="title">The Simple Idea</p>
        <p class="idea-line" data-idea="1">The closer you measure, the longer it gets.</p>
        <p class="idea-line" data-idea="2">The ruler is part of the answer.</p>
      </div>
    </section>
    <section
      id="koch-scene"
      class="koch-scene"
      data-iteration="0"
      data-reveal-stage="0"
    >
      <div class="koch-sticky">
        <div class="koch-geometry">
          <div class="koch-titleblock">
            <div class="koch-header">
              <h1>Meet the Koch snowflake.</h1>
              <p class="koch-intro-detail">It looks like a simple six-pointed star, however&hellip;</p>
            </div>
            <p class="koch-intro-line">It is actually an infinitely iterating shape!</p>
          </div>
          <div class="koch-visual">
            <svg
              class="koch-svg"
              viewBox="-1.1 -1.1 2.2 2.2"
              role="img"
              aria-label="Koch snowflake construction, current iteration"
            >
              <g class="koch-wrapper" id="koch-wrapper">
                <path
                  id="koch-path-reference"
                  d={referencePathD}
                  vector-effect="non-scaling-stroke"
                  aria-hidden="true"
                />
                <path id="koch-path" vector-effect="non-scaling-stroke" />
              </g>
            </svg>
            <div class="koch-inset" aria-hidden="true">
              <svg class="koch-inset-svg" viewBox="0 -0.05 0.4 0.4">
                <path id="koch-inset-path" vector-effect="non-scaling-stroke" />
              </svg>
              <p class="koch-inset-label">Zoomed detail</p>
            </div>
            <p class="scroll-cue">Scroll to look closer.</p>
          </div>
          <dl class="koch-readout" id="koch-readout">
            <div class="koch-readout-scale">
              <dt>Smallest detail counted</dt>
              <dd id="stat-scale">1.000000</dd>
            </div>
            <div class="koch-readout-arrow" aria-hidden="true">&rarr;</div>
            <div class="koch-readout-length">
              <dt>Measured length</dt>
              <dd id="stat-m1">3.0000</dd>
            </div>
          </dl>
          <p class="koch-readout-caption">Details below this size are ignored.</p>
        </div>
        <div class="koch-copy">
          <ol class="reveal-list" id="reveal-list">
            {revealCopy.map((text, i) => <li data-stage={i}>{text}</li>)}
          </ol>
          <dl class="instrumentation" id="instrumentation">
            <div>
              <dt>Iteration</dt>
              <dd id="stat-iteration">0</dd>
            </div>
            <div>
              <dt>Segments</dt>
              <dd id="stat-segments">3</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
    <section id="resolution-scene" class="resolution-scene" aria-label="Resolution">
      <p class="resolution-label resolution-label-gap" data-stage="1">
        Exactly the point and the rare thing!
      </p>
      <p class="resolution-line" data-stage="2">
        <strong>Fractal family.</strong><br>
        It turns out that the coastline and this curve are all fractal patterns. When
        zooming in, details on the edges emerge infinitely...
      </p>
      <div class="resolution-aside resolution-lead-gap" data-stage="3">
        <svg
          class="hilbert-bg"
          viewBox="0 0 1 1"
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
        >
          <path d={hilbertBgPathD} vector-effect="non-scaling-stroke" />
        </svg>
        <p class="resolution-aside-text">
          <strong>Even can fill in a plane ?!</strong><br>
          In extreme senarios, a fractal curve can be infinitely zigzaged and almost
          filling in the entire 2D area it occupies...
        </p>
      </div>
      <p class="resolution-label resolution-label-gap resolution-lead-gap" data-stage="4">
        The tortuosity of fractals!
      </p>
      <p class="resolution-line" data-stage="5">
        <strong>How tortuous it is?</strong><br>
        Actually, the "Hausdorff dimension" D tells how tortuous these fractal
        patterns are!
      </p>
      <p class="resolution-line" data-stage="6">
        If we zoomed in, each curve/unit is shrunk to 1/s, and is replaced with
        N shrunk results, the Hausdorff dimension would be D = log<sub>s</sub>N.
      </p>
      <p class="resolution-line" data-stage="7">
        It measures how &lsquo;big&rsquo; the pattern is in terms of
        complexity and space-filling ability. For the snowflake, this value is <i>D</i><sub><i>Koch</i></sub> =
        log<sub>3</sub>4 &asymp; 1.261. Closer to 2 meaning that a pattern is
        almost filling in the whole 2D plane!
      </p>
      <div
        class="dimension-scale"
        data-stage="8"
        aria-label="Dimension scale from a line to a plane, marked at the Koch snowflake's dimension of 1.26"
      >
        <div class="dimension-track">
          <span class="dimension-tick" style="left: 0%">
            <span class="dimension-tick-value">1</span>
            <span class="dimension-tick-label">line</span>
          </span>
          <span class="dimension-tick dimension-tick-marker" style="left: 26.186%">
            <span class="dimension-tick-value">1.26</span>
            <span class="dimension-tick-label">Koch snowflake</span>
          </span>
          <span class="dimension-tick" style="left: 100%">
            <span class="dimension-tick-value">2</span>
            <span class="dimension-tick-label">plane</span>
          </span>
        </div>
      </div>
      <p class="resolution-line" data-stage="9">
        For the famous Sierpinski triangle, this is log<sub>2</sub>3 &asymp; 1.585, and for
        those coastlines...
      </p>
      <div class="crossfade-container" data-stage="10" aria-hidden="true">
        <svg class="crossfade-koch" viewBox="-1.1 -1.1 2.2 2.2">
          <path d={referencePathD} vector-effect="non-scaling-stroke" />
        </svg>
        <div class="crossfade-countries">
          <figure class="country-figure country-figure-britain">
            <svg
              class="crossfade-norway"
              viewBox={BRITAIN_VIEWBOX}
              preserveAspectRatio="xMidYMid meet"
            >
              <path class="norway-coastline" d={BRITAIN_COASTLINE_PATH} />
            </svg>
            <figcaption class="country-label">
              <span class="country-label-row">
                <button
                  type="button"
                  class="dimension-trigger"
                  aria-expanded="false"
                  aria-label="Show Britain's coastline dimension"
                ><span class="dimension-triangle" aria-hidden="true"></span></button>
                Britain&rsquo;s island
              </span>
              <span class="dimension-reveal">D &asymp; 1.21</span>
            </figcaption>
          </figure>
          <figure class="country-figure country-figure-norway">
            <svg
              class="crossfade-norway"
              viewBox={NORWAY_VIEWBOX}
              preserveAspectRatio="xMidYMid meet"
            >
              <path class="norway-land" d={NORWAY_LAND_PATH} />
              <path class="norway-coastline" d={NORWAY_COASTLINE_PATH} />
            </svg>
            <figcaption class="country-label">
              <span class="country-label-row">
                <button
                  type="button"
                  class="dimension-trigger"
                  aria-expanded="false"
                  aria-label="Show Norway's coastline dimension"
                ><span class="dimension-triangle" aria-hidden="true"></span></button>
                Norway
              </span>
              <span class="dimension-reveal">D &asymp; 1.52</span>
            </figcaption>
          </figure>
        </div>
      </div>
      <p class="resolution-label resolution-label-gap resolution-lead-gap" data-stage="11">
        Coastlines aren’t exact fractals—but they behave like them.
      </p>
      <div
        class="dimension-scale"
        data-stage="12"
        aria-label="Dimension scale from a line to a plane, marked at Britain's coastline dimension of 1.21 and Norway's coastline dimension of 1.52"
      >
        <div class="dimension-track">
          <span class="dimension-tick" style="left: 0%">
            <span class="dimension-tick-value">1</span>
            <span class="dimension-tick-label">line</span>
          </span>
          <span class="dimension-tick dimension-tick-marker" style="left: 21%">
            <span class="dimension-tick-value">1.21</span>
            <span class="dimension-tick-label">Britain</span>
          </span>
          <span class="dimension-tick dimension-tick-marker" style="left: 52%">
            <span class="dimension-tick-value">1.52</span>
            <span class="dimension-tick-label">Norway!</span>
          </span>
          <span class="dimension-tick" style="left: 100%">
            <span class="dimension-tick-value">2</span>
            <span class="dimension-tick-label">plane</span>
          </span>
        </div>
      </div>
      <p class="resolution-line" data-stage="13">
        <strong>Coastline tortuosity.</strong><br>
        But there is a way to estimate coastline dimensions based on the formula <i>D</i> = 1 − log<sub><i>G</i></sub>(<i>L</i>/<i>M</i>). <span class="figure-highlight">For the Norway costline, this is a whopping 1.52 dimensions!</span>
        (World's highest-dimensional coastline~)
      </p>
      <p class="resolution-line journal-entry" data-stage="14">
        <span class="journal-entry-text">
          When measuring a coastline, you must decide which details count. A coarse measurement skips small bays and bends; a finer measurement follows them and produces a longer result.
        </span>
        <span class="journal-entry-text">
          For an ideal fractal boundary, this increase never settles—so a coastline has no single length until its scale and convention are fixed.
        </span>
        <span class="journal-entry-text">
          Here, the &ldquo;ruler&rdquo; means the smallest detail your measurement keeps, not the scale of the map. The granularity we choose is part of the answer.
        </span>
      </p>
      <p class="resolution-label resolution-label-gap resolution-lead-gap" data-stage="15">
        You can measure finer, but there is no single &ldquo;true length&rdquo;.
      </p>
      <p class="resolution-line" data-stage="16">
        You can make your ruler smaller, and the measured result will be more detailed, but also bigger. Look closer, and there is always more detail to measure.
      </p>
      <p class="resolution-line" data-stage="17">
        The result depends on your ruler, not the coastline. (true but seems unbelievable)
      </p>
      <div
        class="crossfade-container coastline-samples"
        data-stage="18"
      >
        <div
          class="crossfade-countries"
          aria-label="Norway's own coastline traced at three measuring resolutions: roughly, more detailed, and finer grained"
        >
          <figure class="country-figure">
            <div class="coastline-plot">
              <svg
                class="crossfade-norway"
                viewBox={NORWAY_VIEWBOX}
                preserveAspectRatio="xMidYMid meet"
                aria-hidden="true"
              >
                <path class="norway-coastline" d={NORWAY_OUTLINE_ROUGH_PATH} />
              </svg>
              <span class="coastline-ruler-group">
                <span class="coastline-ruler-tag">Ruler:</span>
                <span class="coastline-ruler coastline-ruler-rough"></span>
              </span>
            </div>
            <figcaption class="country-label">
              <span>Roughly</span>
              <span class="coastline-length">length = 25,148 km</span>
            </figcaption>
          </figure>
          <figure class="country-figure">
            <div class="coastline-plot">
              <svg
                class="crossfade-norway"
                viewBox={NORWAY_VIEWBOX}
                preserveAspectRatio="xMidYMid meet"
                aria-hidden="true"
              >
                <path class="norway-coastline" d={NORWAY_OUTLINE_DETAILED_PATH} />
              </svg>
              <span class="coastline-ruler-group">
                <span class="coastline-ruler-tag">Ruler:</span>
                <span class="coastline-ruler coastline-ruler-detailed"></span>
              </span>
            </div>
            <figcaption class="country-label">
              <span>More detailed</span>
              <span class="coastline-length">length = 28,953 km</span>
            </figcaption>
          </figure>
          <figure class="country-figure">
            <div class="coastline-plot">
              <svg
                class="crossfade-norway"
                viewBox={NORWAY_VIEWBOX}
                preserveAspectRatio="xMidYMid meet"
                aria-hidden="true"
              >
                <path class="norway-coastline" d={NORWAY_OUTLINE_FINE_PATH} />
              </svg>
              <span class="coastline-ruler-group">
                <span class="coastline-ruler-tag">Ruler:</span>
                <span class="coastline-ruler coastline-ruler-fine"></span>
              </span>
            </div>
            <figcaption class="country-label">
              <span>Finer grained</span>
              <span class="coastline-length">length = 100,915 km</span>
            </figcaption>
          </figure>
        </div>
        <p class="coastline-samples-caption">
          <span class="coastline-samples-caption-triangle" aria-hidden="true"></span>
          Measured Coastline Length for Norway
        </p>
        <p class="coastline-samples-note">Measured length correlates with your ruler.</p>
      </div>
      <p class="resolution-final" data-stage="19">
        Details we choose to ignore
        <br />
        is part of the answer.
      </p>
    </section>
    <section id="postscript-scene" class="postscript-scene" aria-label="Postscript">
      <svg
        class="postscript-dragon"
        viewBox={dragonViewBox}
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        {dragonStages.map((stage) => (
          <path
            class="postscript-dragon-path"
            data-stage={stage.stage}
            d={stage.d}
            vector-effect="non-scaling-stroke"
          />
        ))}
      </svg>
      <p class="postscript-label">A postscript</p>
      <hr class="postscript-divider" />
      <p class="postscript-line" data-stage="1">
        We use simple measures
        <br />
        to make a complex world legible.
      </p>
      <p class="postscript-line" data-stage="2">But every measurement leaves something out.</p>
      <p class="postscript-final" data-stage="3">
        The world does not run out of detail
        <br />
        where our measurement stops.
      </p>
      <a href="#intro-scene" id="measure-again" class="measure-again">Measure again</a>
      <p class="map-credit">Made with Natural Earth.</p>
    </section>
  </main>
  <script src="../scripts/intro.ts"></script>
  <script src="../scripts/idea-scene.ts"></script>
  <script src="../scripts/koch-scene.ts"></script>
  <script src="../scripts/resolution.ts"></script>
  <script src="../scripts/dimension-reveal.ts"></script>
  <script src="../scripts/postscript.ts"></script>
</Layout>
