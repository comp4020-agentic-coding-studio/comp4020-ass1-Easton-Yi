---
import Layout from "../layouts/Layout.astro";
import { NORWAY_LAND_PATH, NORWAY_COASTLINE_PATH, NORWAY_VIEWBOX } from "../lib/norway.ts";
import { generateKochPoints, kochPathD, MAX_ITERATION } from "../lib/koch.ts";

// Finest Koch iteration, computed once at build time (it never changes at
// runtime) — the static faint reference outline behind the bright,
// currently-measured outline. See CLAUDE.md "Global correction of the ruler
// misunderstanding": faint = finer detail that exists in the reference,
// bright = the detail retained by the current measurement.
const referencePathD = kochPathD(generateKochPoints(MAX_ITERATION));

// Visual-refinement increment (docs/PROJECT_BRIEF.md, step 5): colour system,
// Norway silhouette, arc divider, and the postscript's coastline echo /
// disappearing readout (docs/EPILOGUE.md). Tide effect is an explicit
// stretch goal in the brief and is not implemented here.
const revealCopy = [
  "Smaller details are ignored.",
  "Keep more detail.",
  "The measured boundary gets longer.",
  "For this curve, new detail never ends.",
  "So its ordinary length never settles.",
];
---

<Layout title="How long is Norway's coastline? — a Hausdorff dimension explainer">
  <main>
    <section id="intro-scene" class="intro-scene" aria-label="Introduction">
      <nav class="home-nav" aria-label="Primary">
        <a href="./">Home</a>
      </nav>
      <svg
        class="intro-silhouette"
        viewBox={NORWAY_VIEWBOX}
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <path class="norway-land" d={NORWAY_LAND_PATH} />
        <path class="norway-coastline" d={NORWAY_COASTLINE_PATH} />
      </svg>
      <div class="intro-voile" aria-hidden="true"></div>
      <div class="intro-copy">
        <p class="intro-line" data-line="1">
          Before we begin, consider one question&hellip;
        </p>
        <p class="intro-line" data-line="2">How long is Norway&rsquo;s coastline?</p>
      </div>
      <button id="compass-button" class="compass-button" type="button">
        Begin the journey
      </button>
      <svg
        class="intro-arc"
        viewBox="0 0 100 10"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M 0 10 L 0 6 Q 50 -4 100 6 L 100 10 Z" />
      </svg>
    </section>
    <section
      id="koch-scene"
      class="koch-scene"
      data-iteration="0"
      data-reveal-stage="0"
    >
      <div class="koch-sticky">
        <div class="koch-geometry">
          <div class="koch-titleblock">
            <div class="koch-header">
              <h1>Meet the Koch snowflake.</h1>
              <p class="koch-intro-detail">It looks like a simple six-pointed star, however&hellip;</p>
            </div>
            <p class="koch-intro-line">It is actually an infinitely iterating shape!</p>
          </div>
          <div class="koch-visual">
            <svg
              class="koch-svg"
              viewBox="-1.1 -1.1 2.2 2.2"
              role="img"
              aria-label="Koch snowflake construction, current iteration"
            >
              <g class="koch-wrapper" id="koch-wrapper">
                <path
                  id="koch-path-reference"
                  d={referencePathD}
                  vector-effect="non-scaling-stroke"
                  aria-hidden="true"
                />
                <path id="koch-path" vector-effect="non-scaling-stroke" />
              </g>
            </svg>
            <div class="koch-inset" aria-hidden="true">
              <svg class="koch-inset-svg" viewBox="0 -0.05 0.4 0.4">
                <path id="koch-inset-path" vector-effect="non-scaling-stroke" />
              </svg>
              <p class="koch-inset-label">Zoomed detail</p>
            </div>
            <p class="scroll-cue">Scroll to look closer.</p>
          </div>
          <dl class="koch-readout" id="koch-readout">
            <div class="koch-readout-scale">
              <dt>Smallest detail counted</dt>
              <dd id="stat-scale">1.000000</dd>
            </div>
            <div class="koch-readout-arrow" aria-hidden="true">&rarr;</div>
            <div class="koch-readout-length">
              <dt>Measured length</dt>
              <dd id="stat-m1">3.0000</dd>
            </div>
          </dl>
          <p class="koch-readout-caption">Details below this size are ignored.</p>
        </div>
        <div class="koch-copy">
          <ol class="reveal-list" id="reveal-list">
            {revealCopy.map((text, i) => <li data-stage={i}>{text}</li>)}
          </ol>
          <dl class="instrumentation" id="instrumentation">
            <div>
              <dt>Iteration</dt>
              <dd id="stat-iteration">0</dd>
            </div>
            <div>
              <dt>Segments</dt>
              <dd id="stat-segments">3</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
    <section id="resolution-scene" class="resolution-scene" aria-label="Resolution">
      <p class="resolution-line" data-stage="1">
        This growth of detail is described by dimension.
      </p>
      <div
        class="dimension-scale"
        data-stage="2"
        aria-label="Dimension scale from a line to a plane, marked at the Koch boundary's dimension of 1.26"
      >
        <div class="dimension-track">
          <span class="dimension-tick" style="left: 0%">
            <span class="dimension-tick-value">1</span>
            <span class="dimension-tick-label">line</span>
          </span>
          <span class="dimension-tick dimension-tick-marker" style="left: 26.186%">
            <span class="dimension-tick-value">1.26</span>
            <span class="dimension-tick-label">Koch boundary</span>
          </span>
          <span class="dimension-tick" style="left: 100%">
            <span class="dimension-tick-value">2</span>
            <span class="dimension-tick-label">plane</span>
          </span>
        </div>
        <p class="dimension-marker-label">Hausdorff dimension: 1.26</p>
      </div>
      <div class="crossfade-container" data-stage="3" aria-hidden="true">
        <svg class="crossfade-koch" viewBox="-1.1 -1.1 2.2 2.2">
          <path d={referencePathD} vector-effect="non-scaling-stroke" />
        </svg>
        <svg
          class="crossfade-norway"
          viewBox={NORWAY_VIEWBOX}
          preserveAspectRatio="xMidYMid meet"
        >
          <path class="norway-land" d={NORWAY_LAND_PATH} />
          <path class="norway-coastline" d={NORWAY_COASTLINE_PATH} />
        </svg>
      </div>
      <p class="resolution-line" data-stage="4">Norway is not a perfect fractal.</p>
      <p class="resolution-line" data-stage="5">
        But every coastline length depends on which details count.
      </p>
      <p class="resolution-final" data-stage="6">
        What we choose to ignore
        <br />
        is part of the answer.
      </p>
    </section>
    <section id="postscript-scene" class="postscript-scene" aria-label="Postscript">
      <svg
        class="postscript-coastline"
        viewBox={NORWAY_VIEWBOX}
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <path class="norway-land" d={NORWAY_LAND_PATH} />
        <path class="norway-coastline" d={NORWAY_COASTLINE_PATH} />
      </svg>
      <p class="postscript-readout" id="postscript-readout" aria-hidden="true">
        Iteration 5 &middot; D &#8776; 1.262
      </p>
      <p class="postscript-label">A postscript</p>
      <p class="postscript-line" data-stage="1">
        We use simple measures
        <br />
        to make a complex world legible.
      </p>
      <p class="postscript-line" data-stage="2">But every measurement leaves something out.</p>
      <p class="postscript-final" data-stage="3">
        The world does not run out of detail
        <br />
        where our measurement stops.
      </p>
      <a href="#intro-scene" id="measure-again" class="measure-again">Measure again</a>
      <p class="map-credit">Made with Natural Earth.</p>
    </section>
  </main>
  <script src="../scripts/intro.ts"></script>
  <script src="../scripts/koch-scene.ts"></script>
  <script src="../scripts/resolution.ts"></script>
  <script src="../scripts/postscript.ts"></script>
</Layout>
