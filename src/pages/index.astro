---
import Layout from "../layouts/Layout.astro";
import { NORWAY_LAND_PATH, NORWAY_COASTLINE_PATH, NORWAY_VIEWBOX } from "../lib/norway.ts";
import { renderMath } from "../lib/math.ts";

// Formulas for #resolution-scene, staged in the order the concept contract
// requires (CLAUDE.md): the primary-idea formula first, the Koch numeric
// result only after the general scaling argument, the construction-aligned
// covering sum last, and the full formal Hausdorff definition inside the
// collapsed <details>. Rendered server-side to static HTML/MathML at build
// time — no client-side KaTeX runtime ships to the page.
const lengthFormula = renderMath(String.raw`L(\varepsilon) = N(\varepsilon)\,\varepsilon`);
const scalingFormula = renderMath(String.raw`N(\varepsilon) \propto \varepsilon^{-D}`);
const derivedFormula = renderMath(String.raw`L(\varepsilon) \propto \varepsilon^{1-D}`);
const emphasisFormula = renderMath(
  String.raw`\varepsilon\downarrow \;\Rightarrow\; L(\varepsilon)\uparrow`,
);
const kochResultFormula = renderMath(String.raw`D = \dfrac{\log 4}{\log 3} \approx 1.262`);
const coveringSumFormula = renderMath(
  String.raw`M_s(\varepsilon) = N(\varepsilon)\,\varepsilon^{s}`,
);
const hausdorffMeasureFormula = renderMath(
  String.raw`H^s_\delta(F) = \inf \sum_i \operatorname{diam}(U_i)^s`,
);
const hausdorffDimensionFormula = renderMath(
  String.raw`\dim_H(F) = \inf\{\, s : H^s(F) = 0 \,\}`,
);

// Visual-refinement increment (docs/PROJECT_BRIEF.md, step 5): colour system,
// Norway silhouette, arc divider, and the postscript's coastline echo /
// disappearing readout (docs/EPILOGUE.md). Tide effect is an explicit
// stretch goal in the brief and is not implemented here.
const revealCopy = [
  "Every segment becomes four. Each new segment is one third as long.",
  "Measure it as a line: the total grows by 4/3 at every step.",
  "Measure the boundary as area: the total shrinks toward zero.",
  "Between length and area is one exponent that stays stable.",
  "That exponent is the curve's Hausdorff dimension.",
];
---

<Layout title="How long is Norway's coastline? — a Hausdorff dimension explainer">
  <main>
    <section id="intro-scene" class="intro-scene" aria-label="Introduction">
      <nav class="home-nav" aria-label="Primary">
        <a href="./">Home</a>
      </nav>
      <svg
        class="intro-silhouette"
        viewBox={NORWAY_VIEWBOX}
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <path class="norway-land" d={NORWAY_LAND_PATH} />
        <path class="norway-coastline" d={NORWAY_COASTLINE_PATH} />
      </svg>
      <div class="intro-voile" aria-hidden="true"></div>
      <div class="intro-copy">
        <p class="intro-line" data-line="1">
          Before we begin, consider one question&hellip;
        </p>
        <p class="intro-line" data-line="2">How long is Norway&rsquo;s coastline?</p>
      </div>
      <button id="compass-button" class="compass-button" type="button">
        Begin the journey
      </button>
      <svg
        class="intro-arc"
        viewBox="0 0 100 10"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M 0 10 L 0 6 Q 50 -4 100 6 L 100 10 Z" />
      </svg>
    </section>
    <section
      id="koch-scene"
      class="koch-scene"
      data-iteration="0"
      data-max-reveal-stage="0"
    >
      <div class="koch-sticky">
        <div class="koch-geometry">
          <h1>Meet the Koch snowflake.</h1>
          <div class="koch-visual">
            <svg
              class="koch-svg"
              viewBox="-1.1 -1.1 2.2 2.2"
              role="img"
              aria-label="Koch snowflake construction, current iteration"
            >
              <g class="koch-wrapper" id="koch-wrapper">
                <path id="koch-path" vector-effect="non-scaling-stroke" />
              </g>
            </svg>
            <div class="koch-inset" aria-hidden="true">
              <svg class="koch-inset-svg" viewBox="0 -0.05 0.4 0.4">
                <path id="koch-inset-path" vector-effect="non-scaling-stroke" />
              </svg>
              <p class="koch-inset-label">Zoomed detail</p>
            </div>
            <p class="scroll-cue">Scroll to look closer.</p>
          </div>
          <dl class="koch-readout" id="koch-readout">
            <div class="koch-readout-scale">
              <dt>Ruler (&epsilon;)</dt>
              <dd id="stat-scale">1.000000</dd>
            </div>
            <div class="koch-readout-arrow" aria-hidden="true">&rarr;</div>
            <div class="koch-readout-length">
              <dt>Measured length</dt>
              <dd id="stat-m1">3.0000</dd>
            </div>
          </dl>
        </div>
        <div class="koch-copy">
          <ol class="reveal-list" id="reveal-list">
            {revealCopy.map((text, i) => <li data-stage={i + 1}>{text}</li>)}
          </ol>
          <dl class="instrumentation" id="instrumentation">
            <div>
              <dt>Iteration</dt>
              <dd id="stat-iteration">0</dd>
            </div>
            <div>
              <dt>Segments</dt>
              <dd id="stat-segments">3</dd>
            </div>
            <div>
              <dt>Critical measure</dt>
              <dd id="stat-md">3.0000</dd>
            </div>
            <div>
              <dt>2D measure of the boundary</dt>
              <dd id="stat-m2">3.000000</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
    <section id="resolution-scene" class="resolution-scene" aria-label="Resolution">
      <p class="resolution-line" data-stage="1">
        Length says infinity. Area says zero. Dimension tells us which measure
        fits.
      </p>
      <div class="resolution-formula" data-stage="2" set:html={lengthFormula} />
      <p class="resolution-formula-gloss" data-stage="2">
        Cover the boundary with N(&epsilon;) steps of length &epsilon;;
        multiply to get the measured length.
      </p>
      <div class="resolution-formula" data-stage="3" set:html={scalingFormula} />
      <p class="resolution-formula-gloss" data-stage="3">
        The number of steps needed grows as the ruler shrinks, at a rate set
        by the exponent D.
      </p>
      <div class="resolution-formula" data-stage="4" set:html={derivedFormula} />
      <p class="resolution-formula-gloss" data-stage="4">
        Substituting shows why: when D is greater than 1, shrinking the ruler
        makes the measured length diverge.
      </p>
      <div class="resolution-emphasis" data-stage="5" set:html={emphasisFormula} />
      <p class="resolution-formula-gloss" data-stage="5">
        Smaller ruler, longer coastline &mdash; whenever D is greater than 1.
      </p>
      <p class="resolution-line" data-stage="6">
        Below D, the scale-weighted measure explodes. Above D, it vanishes. D
        is the critical exponent between a line (1) and a plane (2).
      </p>
      <div class="resolution-formula" data-stage="7" set:html={kochResultFormula} />
      <p class="resolution-formula-gloss" data-stage="7">
        For the Koch curve specifically: each step produces 4 copies at 1/3
        scale, fixing this exponent.
      </p>
      <div class="resolution-formula" data-stage="8" set:html={coveringSumFormula} />
      <p class="resolution-formula-gloss" data-stage="8">
        This is the construction-aligned covering sum used above &mdash; not
        the full formal Hausdorff measure. It describes the total size of an
        &epsilon;-scale cover of the boundary, not the area of the filled
        snowflake.
      </p>
      <details class="resolution-detail" data-stage="9">
        <summary>Formal definition</summary>
        <div set:html={hausdorffMeasureFormula} />
        <div set:html={hausdorffDimensionFormula} />
        <p>
          Cover the set with pieces no larger than delta, choose the cheapest
          such cover, then let delta shrink. The critical exponent is its
          Hausdorff dimension.
        </p>
      </details>
      <p class="resolution-line" data-stage="10">
        Norway is not a perfect mathematical fractal. But the same
        measurement problem returns: a smaller step follows more detail, so a
        coastline length is incomplete without its scale and convention.
      </p>
      <p class="resolution-final" data-stage="11">The ruler is part of the answer.</p>
    </section>
    <section id="postscript-scene" class="postscript-scene" aria-label="Postscript">
      <svg
        class="postscript-coastline"
        viewBox={NORWAY_VIEWBOX}
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <path class="norway-land" d={NORWAY_LAND_PATH} />
        <path class="norway-coastline" d={NORWAY_COASTLINE_PATH} />
      </svg>
      <p class="postscript-readout" id="postscript-readout" aria-hidden="true">
        Iteration 5 &middot; D &#8776; 1.262
      </p>
      <p class="postscript-label">A postscript</p>
      <p class="postscript-line" data-stage="1">
        We use simple measures
        <br />
        to make a complex world legible.
      </p>
      <p class="postscript-line" data-stage="2">But every ruler leaves something out.</p>
      <p class="postscript-final" data-stage="3">
        The world does not run out of detail
        <br />
        when our ruler does.
      </p>
      <a href="#intro-scene" id="measure-again" class="measure-again">Measure again</a>
      <p class="map-credit">Made with Natural Earth.</p>
    </section>
  </main>
  <script src="../scripts/intro.ts"></script>
  <script src="../scripts/koch-scene.ts"></script>
  <script src="../scripts/resolution.ts"></script>
  <script src="../scripts/postscript.ts"></script>
</Layout>
